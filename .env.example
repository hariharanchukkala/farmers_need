PORT=4000

# OpenWeatherMap API key for weather data
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AndhraTaxi (or similar) drone booking API endpoint and key
DRONE_API_BASE_URL=https://api.andhrataxi.example.com
DRONE_API_KEY=your_drone_api_key_here

# LLM endpoint (optional) if you want AI-generated Telugu explanations
LLM_API_URL=https://your-llm-endpoint.example.com
LLM_API_KEY=your_llm_api_key_here
